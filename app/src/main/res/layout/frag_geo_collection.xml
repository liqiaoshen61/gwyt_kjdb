<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/layout_linear_vertical"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_right_frag"
    android:padding="@dimen/nSize10">


    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:background="@mipmap/bg_frag_title"
        android:paddingVertical="@dimen/nSize3">

        <LinearLayout
            style="@style/layout_linear_horizontal"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nSize20"
                android:padding="5dp"
                android:text="工作记录"
                android:textColor="@color/whiteColor"
                android:textSize="16sp"
                android:textStyle="italic|bold" />

            <TextView
                android:id="@+id/tvCount"
                android:layout_gravity="center"
                style="@style/txt_small_white"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="（共xx条）"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="@dimen/nSize7"
            android:src="@mipmap/icon_frag_close" />
    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/nSize2"
        android:layout_marginTop="@dimen/nSize4"
        android:layout_marginBottom="@dimen/nSize8"
        android:background="@drawable/bg_blue_line" />

    <!--    搜索栏头部-->
    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="center">

        <!--  搜索框  -->
        <LinearLayout
            android:id="@+id/llSearchBar"
            style="@style/layout_linear_horizontal"
            android:layout_height="@dimen/nSize40"
            android:layout_marginVertical="@dimen/nSize5"
            android:layout_weight="1"
            android:background="@mipmap/bg_search_bar"
            android:gravity="center_vertical"
            android:padding="3dp"
            android:layout_marginHorizontal="@dimen/nSize12">

            <EditText
                android:id="@+id/etSearch"
                style="@style/layout_allmatch"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="请输入搜索内容"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/whiteColor"
                android:textColorHint="@color/bg_gray"
                android:textSize="14sp" />


            <ImageView
                android:id="@+id/tvClear"
                style="@style/txt_normal"
                android:layout_height="@dimen/nSize25"
                android:gravity="center"
                android:padding="5dp"
                android:src="@mipmap/close_wd" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="#FFFFFF" />

            <TextView
                android:id="@+id/tvSearch"
                style="@style/txt_normal"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="@dimen/nSize7"
                android:paddingRight="@dimen/nSize7"
                android:text="搜索"
                android:textColor="@color/whiteColor" />
        </LinearLayout>


        <ImageView
            android:id="@+id/ivOutPut"
            style="@style/imgStyle35"
            android:src="@mipmap/icon_export1" />


    </LinearLayout>

    <RelativeLayout
        style="@style/layout_allmatch"
        android:layout_marginTop="@dimen/nSize5">

        <!--    标绘收藏夹-->
        <LinearLayout
            android:id="@+id/llGeoCollection"
            style="@style/layout_allmatch"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
               style="@style/layout_linear_horizontal"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/tvTimeFilter"
                    style="@style/txt_normal_white"
                    android:layout_margin="@dimen/nSize4"
                    android:padding="@dimen/nSize6"
                    android:text="时间筛选"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:background="@mipmap/bg_workrecord_filter"
                    android:visibility="visible" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="match_parent"/>

                <TextView
                    android:id="@+id/tvAreaFilter"
                    style="@style/txt_normal_white"
                    android:layout_margin="@dimen/nSize4"
                    android:padding="@dimen/nSize6"
                    android:text="区域筛选"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@mipmap/bg_workrecord_filter"
                    android:visibility="visible" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="match_parent"/>


                <TextView
                    android:id="@+id/tvFinishFilter"
                    style="@style/txt_normal_white"
                    android:layout_margin="@dimen/nSize4"
                    android:layout_weight="1"
                    android:background="@mipmap/bg_workrecord_filter"
                    android:gravity="center"
                    android:padding="@dimen/nSize6"
                    android:text="是否整改"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvFilterReset"
                    style="@style/txt_normal_white"
                    android:layout_margin="@dimen/nSize4"
                    android:padding="@dimen/nSize5"
                    android:text="重置"
                    android:layout_gravity="center"
                    android:drawableRight="@mipmap/icon_reset"
                    android:visibility="invisible" />
            </LinearLayout>


            <!--        标绘收藏夹-->
            <LinearLayout
                android:id="@+id/llMarkerResult"
                style="@style/layout_linear_vertical"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="visible">

                <com.jameni.jamenilistlib.view.RefreshView
                    android:id="@+id/lvGeometyList"
                    style="@style/layout_linear_horizontal" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llGeoStatis"
                style="@style/layout_linear_horizontal"
                android:gravity="center"
                android:padding="3dp"
                android:visibility="visible">

                <TextView
                    style="@style/txt_normal_white"
                    android:background="@drawable/bg_te11111111111"
                    android:padding="@dimen/nSize6"
                    android:text="统计分析"/>
            </LinearLayout>

            <LinearLayout
                style="@style/layout_linear_horizontal"
                android:gravity="right"
                android:padding="3dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llClearAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/nSize10"
                    android:background="@drawable/bg_cicle_lightbule"
                    android:gravity="center"
                    android:padding="@dimen/nSize10"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@mipmap/icon_eraser" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/tvNodata"
            style="@style/txt_big_white"
            android:layout_centerInParent="true"
            android:text="暂无数据"
            android:visibility="gone" />
    </RelativeLayout>
</LinearLayout>
