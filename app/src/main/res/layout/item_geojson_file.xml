<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llGeoItem"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llFileItem"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingEnd="@dimen/nSize10">

        <ImageView
            android:id="@+id/id_treenode_icon"
            android:layout_width="@dimen/nSize18"
            android:layout_height="@dimen/nSize18"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/ivLayerCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="4dp"
            android:padding="2dp"
            android:src="@mipmap/icon_square_unselect" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/whiteColor"
            android:textSize="16dp" />

        <ImageView
            android:id="@+id/ivDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="3dp"
            android:src="@mipmap/feedback_close" />
    </LinearLayout>

</LinearLayout>