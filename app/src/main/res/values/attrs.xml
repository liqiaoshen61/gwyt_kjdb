        <attr name="editable" />
        <attr name="key_weight" />
        <attr name="value_height" />
        <attr name="horizontal_padding" />
        <attr name="vertical_padding" />
        <attr name="underline_visiable" />
        <attr name="field_name" />
        <attr name="isMustFillIn" />
        <attr name="showMustFillIn" />
        <attr name="start_indent" />
        <attr name="clearAble" />
        <attr name="isOnTextChanged"  format="boolean"  />

        <attr name="dialog_center" />
        <attr name="outsie_cancleable" />
        <attr name="height_scale" />
        <attr name="dialog_tag" />
        <attr name="lable_array" />
        <attr name="isReadOnly" />
        <attr name="max_time" />
        <attr name="mini_time" />
        <attr name="def_time" />
        <attr name="time_format_type" />
        <attr name="isAutoGetLocation" />
        <attr name="unit" />
        <attr name="copyAble" />
        <attr name="get_location_type" />
        <attr name="select_time_type" />
        <attr name="old_model" />
        <attr name="showImgCustom" />
        <attr name="showTvCustom" />
        <attr name="icon_resid" />
        <attr name="customTxt" />
        <attr name="showValueBorder" />
        <attr name="showValueBorder2" />
        <attr name="showKeyView" />
