<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_callout2"
    android:orientation="vertical">

    <!--标题栏-->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/nSize5"
        android:background="@mipmap/bg_frag_title"
        android:paddingVertical="@dimen/nSize3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nSize20"
            android:padding="5dp"
            android:text="重置水印密码"
            android:textColor="@color/whiteColor"
            android:textSize="16sp"
            android:textStyle="italic|bold" />

        <ImageView
            android:id="@+id/imgClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/nSize15"
            android:padding="@dimen/nSize7"
            android:src="@mipmap/feedback_close2" />
    </RelativeLayout>

    <!--内容区域-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/nSize20">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请输入安全校验码"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nSize10"
            android:background="@drawable/edit_text_bg"
            android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
            android:hint="仅支持数字和字母"
            android:inputType="textVisiblePassword"
            android:maxLength="32"
            android:maxLines="1"
            android:padding="@dimen/nSize10"
            android:textColor="@color/white"
            android:textColorHint="@color/bg_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nSize8"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/nSize20"
            android:background="@drawable/btn_main"
            android:paddingHorizontal="@dimen/nSize40"
            android:paddingVertical="@dimen/nSize8"
            android:text="确认"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
