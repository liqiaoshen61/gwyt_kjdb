<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_white"
    android:orientation="vertical">



    <RelativeLayout
        android:id="@+id/top"
        style="@style/layout_normal"
        android:background="@drawable/bg_header"
        android:padding="@dimen/nSize10">

        <TextView
            android:id="@+id/tv_layer_name"
            style="@style/txt_big_white"
            android:text="授权延长使用期限" />

        <ImageView
            android:id="@+id/imgClose"
            style="@style/layout_allwarp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/nSize3"
            android:src="@mipmap/feedback_close2" />
    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

        <!-- 总体状态显示 -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="准备执行操作..."
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- 删除操作区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="删除操作"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:background="#f0f0f0"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/textDeleteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="删除状态: 等待开始"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <ProgressBar
            android:id="@+id/progressBarDelete"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/textDeleteProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0%"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/textDeleteInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已删除: 0/0"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <!-- 复制操作区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="复制操作"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:background="#f0f0f0"
            android:padding="4dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/textTaskStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前任务: -"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/textTaskInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="任务信息: -"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/textOverallProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总进度: 0%"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <ProgressBar
            android:id="@+id/progressBarCopyOverall"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/textTaskProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="任务进度: 0%"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <ProgressBar
            android:id="@+id/progressBarCopyTask"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/textCopied"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已复制: 0 B / 0 B"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/textCurrentFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="当前文件: -"
            android:textSize="12sp"/>

        <!-- 按钮区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始操作"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/buttonCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="取消操作"
                android:backgroundTint="@color/colorAccent"
                android:textColor="@android:color/white"/>

        </LinearLayout>

    </LinearLayout>

    <View
        style="@style/layout_normal"
        android:layout_height="@dimen/nSize1"
        android:layout_marginTop="@dimen/nSize10"
        android:background="@color/txt_gray" />

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:layout_height="@dimen/nSize45"
        android:background="@color/bg_gray">

        <View
            android:layout_width="@dimen/nSize1"
            android:layout_height="match_parent"
            android:background="@color/txt_gray" />

        <TextView
            android:id="@+id/tvOk"
            style="@style/txt_big"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/nSize10"
            android:text="确定" />

    </LinearLayout>

</LinearLayout>
