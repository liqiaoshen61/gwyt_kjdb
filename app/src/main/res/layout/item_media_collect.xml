<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingBottom="5dp"
    android:paddingTop="5dp">

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="center">
        <ImageView
            android:id="@+id/ivfolderIcon"
            android:layout_width="@dimen/nSize30"
            android:layout_height="@dimen/nSize30"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:src="@mipmap/icon_file" />

        <LinearLayout
            style="@style/layout_linear_vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="name"
                android:textColor="#000000"
                android:textSize="15dp" />
            <TextView
                android:id="@+id/tvCreateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="data"
                android:textColor="#000000"
                android:textSize="15dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivMoveIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="5dp"
            android:src="@mipmap/ic_move"
            android:layout_marginRight="10dp"
            android:visibility="gone"
            />
        <ImageView
            android:id="@+id/ivSelect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="5dp"
            android:layout_alignParentRight="true"
            android:src="@mipmap/icon_square_unselect"
            android:layout_marginRight="10dp"
            android:visibility="gone"
            android:layout_marginLeft="5dp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/ivDeleteMedia"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="5dp"
            android:src="@mipmap/icon_clear_maps" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/nSize3"
        android:background="@drawable/bg_gray_line"
        android:paddingTop="@dimen/nSize5" />



</LinearLayout>