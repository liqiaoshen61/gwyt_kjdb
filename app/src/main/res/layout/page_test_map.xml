<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/whiteColor"
    style="@style/layout_allmatch">

    <com.esri.arcgisruntime.mapping.view.MapView
        android:id="@+id/mapView"
        style="@style/layout_allmatch" />


    <LinearLayout
        style="@style/layout_linear_vertical"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <LinearLayout
            style="@style/layout_linear_horizontal">

            <TextView
                android:id="@+id/tvBtn1"
                style="@style/txt_normal_white"
                android:padding="@dimen/nSize10"
                android:background="@drawable/btn_main"
                android:text="绘制缓冲区"/>


        </LinearLayout>

        <LinearLayout
            style="@style/layout_linear_horizontal">

            <EditText
                android:id="@+id/etRadius"
                android:layout_weight="1"
                android:background="@color/bg_gray"
                android:hint="输入半径"
                android:inputType="number"
                style="@style/et_normal"/>


            <EditText
                android:id="@+id/etNum"
                android:layout_weight="1"
                android:background="@color/bg_gray"
                android:hint="圈数（最大7）"
                android:inputType="number"
                style="@style/et_normal"/>

            <TextView
                android:id="@+id/tvBtnOk"
                style="@style/txt_normal_white"
                android:padding="@dimen/nSize10"
                android:background="@drawable/btn_main"
                android:text="绘制"/>


        </LinearLayout>

    </LinearLayout>



</RelativeLayout>
