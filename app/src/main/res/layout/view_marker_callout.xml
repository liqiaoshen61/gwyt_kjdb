<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/layout_linear_vertical"
    android:layout_width="300dp"
    android:minWidth="@dimen/nSize150"
    android:background="@mipmap/bg_callout2">


    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:background="@mipmap/bg_frag_title"
        android:layout_width="match_parent"
        android:paddingVertical="@dimen/nSize3">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="5dp"
            android:textStyle="italic|bold"
            android:layout_marginStart="@dimen/nSize20"
            android:text="工作记录"
            android:textColor="@color/whiteColor"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/imgNavigation"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="@dimen/nSize7"
            android:layout_marginEnd="@dimen/nSize5"
            android:src="@mipmap/icon_navigation" />

        <ImageView
            android:id="@+id/imgClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="@dimen/nSize7"
            android:layout_marginEnd="@dimen/nSize10"
            android:src="@mipmap/icon_frag_close" />
    </LinearLayout>


    <ScrollView
        style="@style/layout_allmatch"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/nSize5"
        android:paddingHorizontal="@dimen/nSize20"
        android:paddingVertical="@dimen/nSize15"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llItems"
            style="@style/layout_linear_vertical"
            android:paddingLeft="@dimen/nSize10"
            android:paddingRight="@dimen/nSize10"
            android:paddingBottom="@dimen/nSize5">

            <TextView
                android:id="@+id/tvRiverName"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />
            <TextView
                android:id="@+id/tvCity"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />
            <TextView
                android:id="@+id/tvCounty"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />
            <TextView
                android:id="@+id/tvQuestionType"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />
            <TextView
                android:id="@+id/tvQuestionAttr"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />

            <TextView
                android:id="@+id/tvSeverity"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />

            <TextView
                android:id="@+id/tvDescription"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />

            <TextView
                android:id="@+id/tvLocation"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />
            <TextView
                android:id="@+id/tvLatLng"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />
            <TextView
                android:id="@+id/tvCheckTime"
                style="@style/txt_normal"
                android:layout_width="match_parent"
                android:textColor="@color/whiteColor"
               android:paddingVertical="@dimen/nSize3"
                android:text="des" />

            <LinearLayout
                style="@style/layout_linear_horizontal"
                android:layout_marginTop="@dimen/nSize10"
                android:gravity="center">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="0.6"/>

                <LinearLayout
                    android:id="@+id/btnTakePhoto"
                    style="@style/callout_action"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/nSize5"
                    android:paddingHorizontal="@dimen/nSize12"
                    android:background="@mipmap/bg_callout_btn">

                    <ImageView
                        android:id="@+id/ivCamera"
                        style="@style/imgStyle20"
                        android:src="@mipmap/icon_camera"/>

                    <TextView
                        android:id="@+id/tvCamera"
                        style="@style/txt_normal_white"
                        android:layout_marginTop="@dimen/nSize3"
                        android:text="现场拍照" />

                </LinearLayout>



                <TextView
                    android:id="@+id/btnMedia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/whiteColor"
                    android:padding="@dimen/nSize3"
                    android:background="@drawable/bg_measure"
                    android:text="附件"
                    android:drawableTop="@mipmap/icon_enclosure"
                    android:drawablePadding="3dp"
                    android:visibility="gone"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="0.6"/>

            </LinearLayout>



        </LinearLayout>

    </ScrollView>

   
</LinearLayout>
