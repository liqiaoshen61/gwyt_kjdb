<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llSearchContent"
    style="@style/layout_linear_vertical"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="@dimen/nSize10">

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="5dp"
            android:text="搜索"
            android:textColor="@color/whiteColor"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/ivSearchClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="@dimen/nSize5"
            android:src="@mipmap/feedback_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/nSize2"
        android:layout_marginTop="@dimen/nSize3"
        android:background="@drawable/bg_blue_line" />

    <!--    搜索栏头部-->
    <include
        android:id="@+id/includeViewSearchBar"
        layout="@layout/view_search_bar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lvPlaceType"
            style="@style/layout_linear_horizontal" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvTotalCount"
        style="@style/txt_small"
        android:layout_marginLeft="@dimen/nSize5"
        android:layout_marginBottom="@dimen/nSize5"
        android:textColor="@color/whiteColor" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout style="@style/layout_linear_vertical">

            <com.jameni.jamenilistlib.view.RefreshView
                android:id="@+id/lvSeaechResult"
                style="@style/layout_allmatch"
                android:layout_marginBottom="@dimen/nSize5"
                android:layout_weight="1" />

            <!--    翻页控制-->
            <include
                android:id="@+id/includeViewPageController"
                layout="@layout/view_page_controller" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/nSize50"
                android:layout_height="@dimen/nSize50"
                android:indeterminateTint="@color/whiteColor" />

            <TextView
                android:id="@+id/tvLoadingText"
                style="@style/txt_small_blue"
                android:text="正在加载"
                android:textColor="@color/whiteColor" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNodata"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:text="无相关查询结果"
            android:textColor="@color/whiteColor"
            android:textSize="15sp"
            android:visibility="gone" />
    </RelativeLayout>


</LinearLayout>
