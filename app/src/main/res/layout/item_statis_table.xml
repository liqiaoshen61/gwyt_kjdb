<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llItem"
    style="@style/layout_linear_horizontal"
    android:padding="@dimen/nSize6">

    <LinearLayout
        style="@style/layout_allmatch"
        android:gravity="center"
        android:layout_marginHorizontal="@dimen/nSize10"
        android:layout_width="wrap_content">

        <ImageView
            android:id="@+id/ivSelect"
            android:layout_width="@dimen/nSize15"
            android:layout_height="@dimen/nSize15"
            android:src="@mipmap/icon_table_select" />
    </LinearLayout>


    <TextView
        android:id="@+id/tvKey"
        style="@style/txt_normal_white"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_weight="1"
        android:text="专题类型" />

    <TextView
        android:id="@+id/tvValue"
        style="@style/txt_normal_white"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_weight="1"
        android:text="已办 / 全部" />


    <TextView
        android:id="@+id/tvValue2"
        style="@style/txt_normal_white"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_weight="1"
        android:text="是问题 / 全部" />




</LinearLayout>