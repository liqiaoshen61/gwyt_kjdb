<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/layout_allmatch"
    android:background="@color/whiteColor">

    <!--    <TextView-->
    <!--        style="@style/txt_big_white"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:background="@color/main_color"-->
    <!--        android:padding="@dimen/nSize10"-->
    <!--        android:text="@string/app_name" />-->

    <LinearLayout
        style="@style/layout_linear_vertical"
        android:layout_height="match_parent"
        android:background="@color/whiteColor">

        <include
            android:id="@+id/viewPageHeader"
            layout="@layout/view_base_header" />

        <LinearLayout
            android:id="@+id/llMainContent"
            style="@style/layout_allmatch"
            android:background="@color/bg_gray"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="@color/half_black2"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/nSize60"
            android:layout_height="@dimen/nSize60"
            android:indeterminateTint="@color/main_color" />

    </LinearLayout>



</RelativeLayout>
