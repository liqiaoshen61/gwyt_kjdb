<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/llEasyAreaView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/layout_linear_vertical"
    android:layout_width="wrap_content"
    android:background="@drawable/bg_te11111111111"
    android:padding="@dimen/nSize8"
    android:layout_marginBottom="@dimen/nSize5">

    <LinearLayout
        android:id="@+id/llArea"
        style="@style/layout_allwarp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/nSize2">
        <LinearLayout
            style="@style/layout_linear_horizontal"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="left">

            <ImageView
                style="@style/imgStyle20"
                android:layout_marginRight="@dimen/nSize3"
                android:src="@mipmap/icon_top_menu_location"/>

            <TextView
                android:id="@+id/tvArea"
                style="@style/txt_big_white"
                android:textColor="@color/white"
                android:text="行政区划" />

        </LinearLayout>


        <ImageView
            android:id="@+id/ivClose"
            style="@style/imgStyle25"
            android:src="@mipmap/close_wd"
            android:layout_marginStart="@dimen/nSize5"
            android:padding="@dimen/nSize5"
            android:visibility="gone"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llcontent"
        android:layout_width="300dp"
        style="@style/layout_linear_vertical"
        android:layout_marginTop="@dimen/nSize5"
        android:visibility="gone">

        <LinearLayout
            style="@style/layout_linear_horizontal"
            android:layout_width="wrap_content"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/llProvince"
                style="@style/layout_linear_vertical"
                android:layout_width="wrap_content"
                android:paddingHorizontal="@dimen/nSize5"
                android:paddingVertical="@dimen/nSize3"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvProvince"
                    style="@style/txt_normal_white"
                    android:layout_marginBottom="@dimen/nSize1"
                    android:text="xx省" />
                <View
                    android:id="@+id/ivProvince"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nSize2"
                    android:background="@color/red" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCity"
                style="@style/layout_linear_vertical"
                android:layout_width="wrap_content"
                android:paddingHorizontal="@dimen/nSize5"
                android:paddingVertical="@dimen/nSize3">
                <TextView
                    android:id="@+id/tvCity"
                    style="@style/txt_normal_white"
                    android:layout_marginBottom="@dimen/nSize1"
                    android:text="xx市" />
                <View
                    android:id="@+id/ivCity"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nSize2"
                    android:background="@color/red" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCounty"
                style="@style/layout_linear_vertical"
                android:layout_width="wrap_content"
                android:paddingHorizontal="@dimen/nSize5"
                android:paddingVertical="@dimen/nSize3">
                <TextView
                    android:id="@+id/tvCounty"
                    style="@style/txt_normal_white"
                    android:layout_marginBottom="@dimen/nSize1"
                    android:text="xx县" />
                <View
                    android:id="@+id/ivCounty"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nSize2"
                    android:background="@color/red"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTown"
                style="@style/layout_linear_vertical"
                android:layout_width="wrap_content"
                android:paddingHorizontal="@dimen/nSize5"
                android:paddingVertical="@dimen/nSize3">
                <TextView
                    android:id="@+id/tvTown"
                    style="@style/txt_normal_white"
                    android:layout_marginBottom="@dimen/nSize1"
                    android:text="xx镇" />
                <View
                    android:id="@+id/ivTown"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nSize2"
                    android:background="@color/red"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llVillage"
                style="@style/layout_linear_vertical"
                android:layout_width="wrap_content"
                android:paddingHorizontal="@dimen/nSize5"
                android:paddingVertical="@dimen/nSize3"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvVillage"
                    style="@style/txt_normal_white"
                    android:layout_marginBottom="@dimen/nSize1"
                    android:text="xx村" />
                <View
                    android:id="@+id/ivVillage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nSize2"
                    android:background="@color/red"/>
            </LinearLayout>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lvMain"
            style="@style/layout_allmatch" />


    </LinearLayout>






</LinearLayout>



