<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/layout_linear_horizontal"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/nSize10"
    android:paddingVertical="@dimen/nSize12">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_gravity="center"
        style="@style/imgStyle23" />

    <TextView
        android:id="@+id/tvTxt"
        style="@style/txt_normal_white"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/nSize8"
        android:layout_weight="1"
        android:text="" />

</LinearLayout>
