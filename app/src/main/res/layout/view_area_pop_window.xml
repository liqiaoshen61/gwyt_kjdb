<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   style="@style/layout_allwarp"
    android:orientation="vertical"
    android:padding="@dimen/nSize12"
    android:background="@drawable/bg_blue_square6">

    <LinearLayout
       style="@style/layout_linear_horizontal"
        android:gravity="center">

        <TextView
            style="@style/txt_big_white"
            android:textStyle="bold"
            android:text="当前区域："/>

        <LinearLayout
            android:id="@+id/llProvince"
            style="@style/layout_linear_vertical"
            android:layout_width="wrap_content"
            android:paddingHorizontal="@dimen/nSize8"
            android:paddingVertical="@dimen/nSize3"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvProvince"
                style="@style/txt_normal_white"
                android:layout_marginBottom="@dimen/nSize1"
                android:text="xx省" />
            <View
                android:id="@+id/ivProvince"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nSize2"
                android:background="@color/red" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCity"
            style="@style/layout_linear_vertical"
            android:layout_width="wrap_content"
            android:paddingHorizontal="@dimen/nSize8"
            android:paddingVertical="@dimen/nSize3">
            <TextView
                android:id="@+id/tvCity"
                style="@style/txt_normal_white"
                android:layout_marginBottom="@dimen/nSize1"
                android:text="xx市" />
            <View
                android:id="@+id/ivCity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nSize2"
                android:background="@color/red" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCounty"
            style="@style/layout_linear_vertical"
            android:layout_width="wrap_content"
            android:paddingHorizontal="@dimen/nSize8"
            android:paddingVertical="@dimen/nSize3">
            <TextView
                android:id="@+id/tvCounty"
                style="@style/txt_normal_white"
                android:layout_marginBottom="@dimen/nSize1"
                android:text="xx县" />
            <View
                android:id="@+id/ivCounty"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nSize2"
                android:background="@color/red"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llTown"
            style="@style/layout_linear_vertical"
            android:layout_width="wrap_content"
            android:paddingHorizontal="@dimen/nSize8"
            android:paddingVertical="@dimen/nSize3">
            <TextView
                android:id="@+id/tvTown"
                style="@style/txt_normal_white"
                android:layout_marginBottom="@dimen/nSize1"
                android:text="xx镇" />
            <View
                android:id="@+id/ivTown"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nSize2"
                android:background="@color/red"/>
        </LinearLayout>


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lvMain"
        style="@style/layout_allmatch" />
</LinearLayout>
