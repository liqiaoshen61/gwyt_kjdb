<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_white"
    android:orientation="vertical">

    <!--    标题-->
    <RelativeLayout
        android:id="@+id/top"
        style="@style/dialog_header">

        <TextView
            android:id="@+id/tv_layer_name"
            style="@style/txt_big_white"
            android:layout_centerVertical="true"
            android:text="Excel列表" />

        <ImageView
            android:id="@+id/imgClose"
            style="@style/layout_allwarp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@mipmap/feedback_close2" />

    </RelativeLayout>

    <include
        android:id="@+id/includeList"
        layout="@layout/view_list" />

</LinearLayout>