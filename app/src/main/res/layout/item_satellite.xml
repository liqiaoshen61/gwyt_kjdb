<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_sat_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="5dp">

    <!-- 星座名称（用星座色） -->
    <TextView
        android:id="@+id/tvSatConstellation"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:singleLine="true"
        android:text="GPS"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 卫星编号 -->
    <TextView
        android:id="@+id/tvSatSvid"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="01"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!-- 信号强度：进度条 + 数值 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/tvSatSignalBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:maxHeight="8dp"
            android:max="55"
            android:minHeight="8dp"
            android:progress="0"
            android:progressDrawable="@drawable/bg_sat_bar" />

        <TextView
            android:id="@+id/tvSatCn0"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 仰角 -->
    <TextView
        android:id="@+id/tvSatElevation"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0°"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!-- 方位角 -->
    <TextView
        android:id="@+id/tvSatAzimuth"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0°"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!-- 载波频率 -->
    <TextView
        android:id="@+id/tvSatFreq"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:text="—"
        android:textColor="@color/sat_sub"
        android:textSize="12sp" />

    <!-- 状态：定位中为“用” -->
    <TextView
        android:id="@+id/tvSatUsed"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
