<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/layout_linear_horizontal"
    android:paddingLeft="@dimen/nSize5"
    android:gravity="center_vertical">

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:layout_weight="2"
        android:gravity="center_vertical">


        <RelativeLayout
            android:id="@+id/rlImage"
            android:layout_width="@dimen/nSize40"
            android:layout_height="@dimen/nSize40">

            <ImageView
                android:id="@+id/imgCheck"
                android:layout_width="@dimen/nSize20"
                android:layout_height="@dimen/nSize20"
                android:layout_centerInParent="true"
                android:layout_marginLeft="@dimen/nSize10"
                android:scaleType="centerInside"
                android:src="@mipmap/logo_unselected" />
        </RelativeLayout>
        <TextView
            android:id="@+id/tvName"
            style="@style/txt_normal_white"
            android:layout_width="match_parent"
            android:padding="@dimen/nSize12"
            android:text="123" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rlDetail"
        style="@style/layout_normal"
        android:layout_weight="8"
        android:visibility="gone">

        <TextView
            style="@style/txt_normal"
            android:padding="@dimen/nSize12"
            android:text="" />

<!--        <ImageView-->
<!--            android:id="@+id/imgDetail"-->
<!--            android:layout_width="@dimen/nSize20"-->
<!--            android:layout_height="@dimen/nSize20"-->
<!--            android:layout_alignParentRight="true"-->
<!--            android:layout_centerVertical="true"-->
<!--            android:layout_marginLeft="@dimen/nSize10"-->
<!--            android:layout_marginRight="@dimen/nSize10"-->
