<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="5dp"
    android:paddingVertical="@dimen/nSize3">

    <LinearLayout
        android:id="@+id/llMarkerItem"
        style="@style/layout_linear_horizontal"

        android:gravity="center">

        <LinearLayout
            style="@style/layout_linear_vertical"
            android:layout_width="0dp"
            android:layout_weight="1">


            <TextView
                android:id="@+id/tvName"
                style="@style/txt_normal_white"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/tvTime"
                style="@style/txt_normal_white"
                android:text="时间" />
        </LinearLayout>


        <ImageView
            android:id="@+id/imgSelect"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/nSize2"
            android:src="@mipmap/icon_square_unselect"
            android:visibility="visible" />


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/nSize10"
        android:background="@drawable/bg_dash_line_blue"
        android:layerType="software"
        android:paddingTop="@dimen/nSize3" />

</LinearLayout>