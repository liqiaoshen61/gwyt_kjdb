<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/layout_allwarp"
    android:layout_marginTop="@dimen/nSize10"
    android:gravity="center"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/rlImg"
        android:layout_width="90dp"
        android:layout_height="70dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/whiteColor"
            android:padding="0.5dp">

            <ImageView
                android:id="@+id/imgPic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center" />

        </RelativeLayout>

        <ImageView
            android:id="@+id/imgbac"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@mipmap/alape"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgDelect"
            style="@style/imgStyle25"
            android:padding="@dimen/nSize5"
            android:layout_alignParentEnd="true"
            android:background="@mipmap/feedback_close" />

    </RelativeLayout>

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="center">

        <CheckBox
            android:id="@+id/cbSelect"
            style="@style/txt_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/nSize2"
            android:buttonTint="@color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvName"
            style="@style/txt_normal_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/nSize2"
            android:lines="2"
            android:ellipsize="end"
            android:text="图片名称图片名称图片名称" />


    </LinearLayout>


</LinearLayout>