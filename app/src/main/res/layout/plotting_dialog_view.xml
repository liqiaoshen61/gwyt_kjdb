<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/whiteColor"
    android:orientation="vertical">

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="center"
        android:padding="@dimen/nSize12">

        <TextView
            style="@style/txt_big"
            android:layout_weight="0"
            android:layout_width="80dp"
            android:text="名称：" />

        <LinearLayout
            style="@style/layout_linear_horizontal"
            android:background="@drawable/bg_edittext_bar"
            android:layout_weight="1"
            android:padding="@dimen/nSize5">

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/please_input" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="left"
        android:padding="@dimen/nSize12"
        android:visibility="gone">

        <TextView
            style="@style/txt_big"
            android:text="目录：" />

        <Spinner
            android:id="@+id/sp_type"
            android:layout_width="@dimen/nSize120"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/bh_add_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新建文件夹" />
    </LinearLayout>

    <LinearLayout
        style="@style/layout_linear_horizontal"
        android:gravity="center"
        android:padding="@dimen/nSize12">

        <TextView
            style="@style/txt_big"
            android:layout_weight="0"
            android:layout_width="80dp"
            android:text="工作内容：" />

        <LinearLayout
            style="@style/layout_linear_horizontal"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext_bar"
            android:padding="@dimen/nSize5">

            <EditText
                android:id="@+id/et_remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/please_input" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">


        <Button
            android:id="@+id/btn_camera"
            style="@style/layout_allwarp"
            android:background="@drawable/bg_trans_square"
            android:textColor="@color/black"
            android:text="添加照片" />


        <Button
            android:id="@+id/btn_look_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="附件"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>