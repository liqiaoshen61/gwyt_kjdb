<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llHandSearchActions"
    style="@style/layout_allwarp"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="@dimen/nSize40"
    android:background="@drawable/bg_measure_gradient"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/nSize2"
    android:visibility="gone">


    <TextView
        android:id="@+id/tvHandSearch"
        style="@style/measureMarkerBtns"
        android:drawableTop="@mipmap/icon_search"
        android:drawablePadding="3dp"
        android:text="搜索"
        android:textColor="@color/whiteColor" />

    <TextView
        android:id="@+id/tvHandSearchPreStep"
        style="@style/measureMarkerBtns"
        android:drawableTop="@mipmap/icon_prestep"
        android:drawablePadding="3dp"
        android:text="回退"
        android:textColor="@color/whiteColor" />

    <TextView
        android:id="@+id/tvHandSearchReset"
        style="@style/measureMarkerBtns"
        android:drawableTop="@mipmap/icon_reset"
        android:drawablePadding="3dp"
        android:hint="编辑"
        android:text="重置"
        android:textColor="@color/whiteColor"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvHandSearchCancel"
        style="@style/measureMarkerBtns"
        android:drawableTop="@mipmap/icon_cancel_measure"
        android:drawablePadding="@dimen/nSize3"
        android:hint="取消绘"
        android:padding="@dimen/nSize5"
        android:text="关闭"
        android:textColor="@color/whiteColor"
        android:visibility="visible" />


</LinearLayout>
