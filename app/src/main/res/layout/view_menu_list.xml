<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actionList"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_menu_list"
    android:layout_alignParentLeft="true">




    <LinearLayout
        style="@style/layout_linear_vertical"
        android:layout_width="wrap_content"
        android:layout_marginHorizontal="@dimen/nSize15"
        android:layout_marginVertical="@dimen/nSize15"
        android:layout_gravity="center"
        android:gravity="left">

        <LinearLayout
            android:id="@+id/llMenuSurvey"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@drawable/ic_survey_boundary" />
            <TextView
                style="@style/txt_main_menu"
                android:layout_marginTop="@dimen/nSize12"
                android:textColor="#B8C9DF"
                android:text="勘界作业" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuMaps"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center">


            <ImageView
                android:id="@+id/ivMenuMaps"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_map_c" />

            <TextView
                android:id="@+id/tvMenuMaps"
                style="@style/txt_main_menu"
                android:layout_marginTop="@dimen/nSize12"
                android:textColor="#B8C9DF"
                android:letterSpacing="0.06"
                android:text="数据资源" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuArea"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivMenuArea"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_area_c" />

            <TextView
                android:id="@+id/tvMenuArea"
                style="@style/txt_main_menu"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nSize12"
                android:textColor="#B8C9DF"
                android:letterSpacing="0.06"
                android:text="数据统计" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuSearch"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivMenuSearch"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_search_c" />

            <com.jwch.gwyt_project.view.StrokeTextView
                android:id="@+id/tvMenuSearch"
                style="@style/txt_main_menu"
                android:text="搜索" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llMenuTools"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivMenuTools"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_tools_c" />

            <TextView
                android:id="@+id/tvMenuTools"
                style="@style/txt_main_menu"
                android:layout_marginTop="@dimen/nSize12"
                android:textColor="#B8C9DF"
                android:letterSpacing="0.06"
                android:text="新增记录" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuCollection"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivMenuCollection"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_mark_c" />

            <TextView
                android:id="@+id/tvMenuCollection"
                style="@style/txt_main_menu"
                android:layout_marginTop="@dimen/nSize12"
                android:textColor="#B8C9DF"
                android:letterSpacing="0.06"
                android:text="图斑收藏" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAnalysis"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAnalysis"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_search_c" />

            <com.jwch.gwyt_project.view.StrokeTextView
                android:id="@+id/tvMenuAnalysis"
                style="@style/txt_main_menu"
                android:text="空间检索" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llMenuSetting"
            style="@style/layout_linear_vertical"
            android:layout_marginBottom="35dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivMenuSetting"
                android:layout_width="@dimen/nSize35"
                android:layout_height="@dimen/nSize35"
                android:src="@mipmap/icon_setting_c" />

            <TextView
                android:id="@+id/tvMenuSetting"
                style="@style/txt_main_menu"
                android:layout_marginTop="@dimen/nSize12"
                android:textColor="#B8C9DF"
                android:letterSpacing="0.06"
                android:text="设 置" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
